@model List<Education>

@{
    ViewData["Title"] = "Eğitim";
    ViewData["Description"] = "Eğitim geçmişi, en yeniden eskiye. Pasif kayıtlar sitede gösterilmez.";

    var activeCount = Model.Count(education => education.IsActive);
}

@section Actions {
    <a class="btn btn-primary" asp-action="CreateEducation"><i class="bi bi-plus-lg"></i>Yeni eğitim</a>
}

@if (Model.Count == 0)
{
    <section class="glass ticks pa-empty">
        <glass-icon name="education" size="140" />
        <h3>Henüz eğitim eklenmedi</h3>
        <p>Okul ve bölüm bilgilerinizi ekleyin; sitede tarih sırasına göre listelenir.</p>
        <a class="btn btn-primary" asp-action="CreateEducation"><i class="bi bi-plus-lg"></i>İlk eğitimi ekle</a>
    </section>
}
else
{
    <div class="pa-stats">
        <span><b>@Model.Count</b> kayıt</span>
        <span><b>@activeCount</b> aktif</span>
        <span><b>@(Model.Count - activeCount)</b> pasif</span>
    </div>

    <section class="glass ticks pa-panel">
        <div class="pa-table-wrap">
            <table class="pa-table">
                <thead>
                    <tr>
                        <th>Okul</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="cell-actions"><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var education in Model)
                    {
                        <tr>
                            <td>
                                <span class="cell-title">@education.EducationTitle</span>
                                @if (!string.IsNullOrWhiteSpace(education.SubTitle))
                                {
                                    <span class="cell-sub">@education.SubTitle</span>
                                }
                            </td>
                            <td class="cell-mono">
                                @education.StartDate.ToString("yyyy-MM") → @(education.EndDate?.ToString("yyyy-MM") ?? "devam")
                            </td>
                            <td>
                                @if (education.IsActive)
                                {
                                    <span class="pa-badge is-on">Aktif</span>
                                }
                                else
                                {
                                    <span class="pa-badge is-off">Pasif</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <a class="btn btn-ghost btn-icon" title="Düzenle" aria-label="Düzenle"
                                   asp-action="UpdateEducation" asp-route-id="@education.EducationId">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form class="d-inline" method="post"
                                      asp-action="DeleteEducation" asp-route-id="@education.EducationId"
                                      data-confirm="@education.EducationTitle kaydı kalıcı olarak silinecek."
                                      data-confirm-title="Eğitim silinsin mi?">
                                    <button type="submit" class="btn btn-danger-ghost btn-icon" title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
