@model Education

@{
    ViewData["Title"] = "Eğitimi düzenle";
    ViewData["Description"] = Model.EducationTitle;
}

<form asp-action="UpdateEducation" method="post" class="glass ticks pa-panel-pad">
    <input type="hidden" asp-for="EducationId" />
    <partial name="_EducationForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="EducationList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Değişiklikleri kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
