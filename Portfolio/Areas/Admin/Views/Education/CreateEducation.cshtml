@model Education

@{
    ViewData["Title"] = "Yeni eğitim";
    ViewData["Description"] = "Okul, bölüm ve tarih aralığı.";
}

<form asp-action="CreateEducation" method="post" class="glass ticks pa-panel-pad">
    <partial name="_EducationForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="EducationList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
