@model Education

<div asp-validation-summary="ModelOnly"></div>

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="EducationTitle" class="form-label"></label>
        <input asp-for="EducationTitle" class="form-control" placeholder="Üniversite veya kurum" />
        <span asp-validation-for="EducationTitle"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="SubTitle" class="form-label"></label>
        <input asp-for="SubTitle" class="form-control" placeholder="Bilgisayar Mühendisliği, Lisans" />
        <span asp-validation-for="SubTitle"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" class="form-control" />
        <span asp-validation-for="StartDate"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" class="form-control" />
        <div class="form-text">Hâlâ devam ediyorsa boş bırakın.</div>
        <span asp-validation-for="EndDate"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" role="switch" />
            <label asp-for="IsActive" class="form-check-label">Portfolyoda göster</label>
        </div>
        <div class="form-text">Kapalıysa kayıt saklanır ama sitede görünmez.</div>
    </div>
</div>
