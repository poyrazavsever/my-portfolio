@model Skill

@{
    ViewData["Title"] = "Yeteneği düzenle";
    ViewData["Description"] = Model.Name;
}

<form asp-action="UpdateSkill" method="post" class="glass ticks pa-panel-pad">
    <input type="hidden" asp-for="SkillId" />
    <partial name="_SkillForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="SkillList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Değişiklikleri kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
