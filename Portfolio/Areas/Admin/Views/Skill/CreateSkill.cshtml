@model Skill

@{
    ViewData["Title"] = "Yeni yetenek";
    ViewData["Description"] = "Teknoloji adı ve 0–100 arası seviye.";
}

<form asp-action="CreateSkill" method="post" class="glass ticks pa-panel-pad">
    <partial name="_SkillForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="SkillList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
