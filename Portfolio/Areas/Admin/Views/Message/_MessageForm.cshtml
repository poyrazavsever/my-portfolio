@model Message

<div asp-validation-summary="ModelOnly"></div>

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="NameSurname" class="form-label"></label>
        <input asp-for="NameSurname" class="form-control" />
        <span asp-validation-for="NameSurname"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" placeholder="ornek@eposta.com" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="col-12">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject"></span>
    </div>

    <div class="col-12">
        <label asp-for="MessageDetail" class="form-label"></label>
        <textarea asp-for="MessageDetail" class="form-control" rows="7"></textarea>
        <span asp-validation-for="MessageDetail"></span>
    </div>
</div>
