@model Message

@{
    ViewData["Title"] = "Mesajı düzenle";
    ViewData["Description"] = "Faz 7'de kaldırılacak: gelen mesajın orijinal içeriği düzenlenmemeli.";
}

<form asp-action="UpdateMessage" method="post" class="glass ticks pa-panel-pad">
    <input type="hidden" asp-for="MessageId" />
    <partial name="_MessageForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="MessageList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
