@model MessageListViewModel

@{
    ViewData["Title"] = "Mesajlar";
    ViewData["Description"] = "İletişim formundan gelen mesajlar. Mesaj içeriği düzenlenemez; yalnızca okundu durumu değişir.";

    // İşlemlerden sonra aynı filtreli görünüme dönmek için.
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@* AJAX isteklerinde (modal açılınca okundu işaretleme) kullanılacak antiforgery token'ı *@
@Html.AntiForgeryToken()

<div class="pa-stats">
    <span><b>@Model.TotalCount</b> mesaj</span>
    <span><b data-unread-total>@Model.UnreadCount</b> okunmamış</span>
    @if (Model.IsFiltered)
    {
        <span><b>@Model.Messages.Count</b> sonuç</span>
    }
</div>

<form method="get" asp-action="MessageList" class="pa-toolbar" role="search">
    <label class="pa-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <span class="visually-hidden">Gönderen veya konuya göre ara</span>
        <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Gönderen, e-posta veya konu" />
    </label>

    <label class="visually-hidden" for="status">Durum</label>
    <select id="status" name="status" class="form-select" data-autosubmit>
        <option value="all" selected="@(Model.Status == "all")">Tümü</option>
        <option value="unread" selected="@(Model.Status == "unread")">Okunmamış</option>
        <option value="read" selected="@(Model.Status == "read")">Okunmuş</option>
    </select>

    <label class="visually-hidden" for="sort">Sıralama</label>
    <select id="sort" name="sort" class="form-select" data-autosubmit>
        <option value="newest" selected="@(Model.Sort == "newest")">En yeni önce</option>
        <option value="oldest" selected="@(Model.Sort == "oldest")">En eski önce</option>
    </select>

    <button type="submit" class="btn btn-ghost">Uygula</button>
    @if (Model.IsFiltered || Model.Sort != "newest")
    {
        <a class="btn btn-ghost" asp-action="MessageList">Temizle</a>
    }
</form>

@if (Model.Messages.Count == 0)
{
    <section class="glass ticks pa-empty">
        <glass-icon name="messages" size="140" />
        @if (Model.IsFiltered)
        {
            <h3>Eşleşen mesaj yok</h3>
            <p>Arama metnini veya durum filtresini değiştirin.</p>
            <a class="btn btn-ghost" asp-action="MessageList">Filtreleri temizle</a>
        }
        else
        {
            <h3>Gelen kutusu boş</h3>
            <p>Sitedeki iletişim formundan gönderilen mesajlar burada listelenir.</p>
        }
    </section>
}
else
{
    <section class="glass ticks pa-panel">
        <div class="pa-table-wrap">
            <table class="pa-table pa-inbox">
                <thead>
                    <tr>
                        <th style="width:28px"><span class="visually-hidden">Durum</span></th>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th class="cell-actions"><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in Model.Messages)
                    {
                        var modalId = $"message-{message.MessageId}";
                        <tr class="@(message.IsRead ? null : "is-unread")" data-message-row="@message.MessageId">
                            <td>
                                <span class="pa-unread-dot" title="@(message.IsRead ? "Okundu" : "Okunmadı")"></span>
                            </td>
                            <td>
                                <span class="cell-title">@message.NameSurname</span>
                                <span class="cell-sub">@message.Email</span>
                            </td>
                            <td>
                                <button type="button" class="pa-link-button" data-bs-toggle="modal" data-bs-target="#@modalId">
                                    @message.Subject
                                </button>
                            </td>
                            <td class="cell-mono">
                                <time datetime="@message.SendDate.ToString("s")">@message.SendDate.ToString("yyyy-MM-dd HH:mm")</time>
                            </td>
                            <td class="cell-actions">
                                <button type="button" class="btn btn-ghost btn-icon" title="Görüntüle" aria-label="Görüntüle"
                                        data-bs-toggle="modal" data-bs-target="#@modalId">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <form class="d-inline" method="post" asp-action="ToggleRead" asp-route-id="@message.MessageId">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-ghost btn-icon"
                                            title="@(message.IsRead ? "Okunmadı işaretle" : "Okundu işaretle")"
                                            aria-label="@(message.IsRead ? "Okunmadı işaretle" : "Okundu işaretle")">
                                        <i class="bi @(message.IsRead ? "bi-envelope" : "bi-envelope-open")"></i>
                                    </button>
                                </form>
                                <form class="d-inline" method="post" asp-action="DeleteMessage" asp-route-id="@message.MessageId"
                                      data-confirm="@message.NameSurname tarafından gönderilen mesaj kalıcı olarak silinecek."
                                      data-confirm-title="Mesaj silinsin mi?">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-danger-ghost btn-icon" title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @foreach (var message in Model.Messages)
    {
        var modalId = $"message-{message.MessageId}";
        <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@modalId-title" aria-hidden="true"
             data-message-id="@message.MessageId"
             data-unread="@(message.IsRead ? "false" : "true")"
             data-mark-read-url="@Url.Action("MarkAsRead", new { id = message.MessageId })"
             data-auto-open="@(Model.OpenId == message.MessageId ? "true" : null)">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-5" id="@modalId-title">@message.Subject</h2>
                            <dl class="pa-message-meta">
                                <div><dt>Gönderen</dt><dd>@message.NameSurname</dd></div>
                                <div><dt>E-posta</dt><dd><a href="mailto:@message.Email">@message.Email</a></dd></div>
                                <div><dt>Tarih</dt><dd>@message.SendDate.ToString("dd.MM.yyyy HH:mm")</dd></div>
                            </dl>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    @* Orijinal içerik salt okunur gösterilir: düzenleme alanı yok. *@
                    <div class="modal-body pa-message-body">@message.MessageDetail</div>
                    <div class="modal-footer">
                        <form method="post" asp-action="ToggleRead" asp-route-id="@message.MessageId" class="me-auto">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-ghost" data-toggle-read-label>
                                @(message.IsRead ? "Okunmadı işaretle" : "Okundu işaretle")
                            </button>
                        </form>
                        <a class="btn btn-ghost" href="mailto:@message.Email?subject=@Uri.EscapeDataString("Re: " + message.Subject)">
                            <i class="bi bi-reply"></i>Yanıtla
                        </a>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
