@model List<Message>

@{
    ViewData["Title"] = "Mesajlar";
    ViewData["Description"] = "İletişim formundan gelen mesajlar.";

    var messages = Model.OrderByDescending(message => message.SendDate).ToList();
    var unreadCount = messages.Count(message => !message.IsRead);
}

@section Actions {
    <a class="btn btn-ghost" asp-action="CreateMessage"><i class="bi bi-plus-lg"></i>Test mesajı</a>
}

@if (messages.Count == 0)
{
    <section class="glass ticks pa-empty">
        <glass-icon name="messages" size="140" />
        <h3>Gelen kutusu boş</h3>
        <p>Sitedeki iletişim formundan gönderilen mesajlar burada listelenir.</p>
    </section>
}
else
{
    <div class="pa-stats">
        <span><b>@messages.Count</b> mesaj</span>
        <span><b>@unreadCount</b> okunmamış</span>
    </div>

    <section class="glass ticks pa-panel">
        <div class="pa-table-wrap">
            <table class="pa-table">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="cell-actions"><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in messages)
                    {
                        var modalId = $"message-{message.MessageId}";
                        <tr>
                            <td>
                                <span class="cell-title">@message.NameSurname</span>
                                <span class="cell-sub">@message.Email</span>
                            </td>
                            <td>@message.Subject</td>
                            <td class="cell-mono">@message.SendDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (message.IsRead)
                                {
                                    <span class="pa-badge is-off">Okundu</span>
                                }
                                else
                                {
                                    <span class="pa-badge is-new">Yeni</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <button type="button" class="btn btn-ghost btn-icon" title="Görüntüle" aria-label="Görüntüle"
                                        data-bs-toggle="modal" data-bs-target="#@modalId">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a class="btn btn-ghost btn-icon" title="Düzenle" aria-label="Düzenle"
                                   asp-action="UpdateMessage" asp-route-id="@message.MessageId">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form class="d-inline" method="post"
                                      asp-action="DeleteMessage" asp-route-id="@message.MessageId"
                                      data-confirm="@message.NameSurname tarafından gönderilen mesaj kalıcı olarak silinecek."
                                      data-confirm-title="Mesaj silinsin mi?">
                                    <button type="submit" class="btn btn-danger-ghost btn-icon" title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @foreach (var message in messages)
    {
        var modalId = $"message-{message.MessageId}";
        <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@modalId-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-5" id="@modalId-title">@message.Subject</h2>
                            <div class="text-mono text-muted-pa" style="font-size:12.5px">
                                @message.NameSurname · @message.Email · @message.SendDate.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body" style="white-space:pre-line">@message.MessageDetail</div>
                    <div class="modal-footer">
                        <a class="btn btn-ghost" href="mailto:@message.Email?subject=Re: @Uri.EscapeDataString(message.Subject)">
                            <i class="bi bi-reply"></i>Yanıtla
                        </a>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
