@model Message

@{
    ViewData["Title"] = "Test mesajı";
    ViewData["Description"] = "Gelen kutusunu denemek için elle mesaj oluşturun.";
}

<form asp-action="CreateMessage" method="post" class="glass ticks pa-panel-pad">
    <partial name="_MessageForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="MessageList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
