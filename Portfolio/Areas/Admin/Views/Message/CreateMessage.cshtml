@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Portfolio.Entities.Message

@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div id="main-content-wrapper">
    <header class="admin-navbar">
        <div class="d-flex align-items-center justify-content-between w-100 gap-3">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm d-lg-none p-1 border-0 text-dark"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileSidebar"
                        aria-controls="mobileSidebar"
                        aria-label="Menüyü aç">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <nav aria-label="Sayfa yolu" class="d-none d-sm-block">
                    <ol class="breadcrumb mb-0 align-items-center small">
                        <li class="breadcrumb-item">
                            <a asp-area="Admin"
                               asp-controller="Message"
                               asp-action="MessageList"
                               class="text-secondary text-decoration-none">
                                Mesajlar
                            </a>
                        </li>
                        <li class="breadcrumb-item active fw-semibold" aria-current="page">Yeni Mesaj</li>
                    </ol>
                </nav>
            </div>

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="MessageList"
               class="btn-pastel-outline text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                <span class="d-none d-sm-inline">Mesajlara Dön</span>
            </a>
        </div>
    </header>

    <main class="main-body-container flex-grow-1 p-4 p-md-4 p-lg-5">
        <div class="mx-auto" style="max-width: 920px;">
            <section class="mb-4">
                <span class="text-uppercase fw-bold"
                      style="font-size: 0.72rem; letter-spacing: 0.08em; color: var(--primary-accent);">
                    İletişim Yönetimi
                </span>
                <h1 class="h3 fw-bold mb-2 mt-1">Yeni Mesaj Ekle</h1>
                <p class="text-secondary mb-0">Gönderici ve mesaj bilgilerini girerek yeni bir kayıt oluştur.</p>
            </section>

            <section class="content-card overflow-hidden">
                <div class="p-3 p-md-4 border-bottom d-flex align-items-center gap-3">
                    <div class="stat-icon-wrap"
                         style="background-color: var(--pastel-purple); color: var(--pastel-purple-text);">
                        <i class="bi bi-envelope-plus-fill"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold mb-1">Mesaj Bilgileri</h2>
                        <p class="text-secondary small mb-0">Tüm temel iletişim alanlarını doldurabilirsin.</p>
                    </div>
                </div>

                <form asp-area="Admin"
                      asp-controller="Message"
                      asp-action="CreateMessage"
                      method="post">
                    <div class="p-3 p-md-4">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        }

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="NameSurname" class="form-label fw-semibold">Ad Soyad</label>
                                <input asp-for="NameSurname" class="form-control" placeholder="Göndericinin adı ve soyadı" />
                                <span asp-validation-for="NameSurname" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Subject" class="form-label fw-semibold">Konu</label>
                                <input asp-for="Subject" class="form-control" placeholder="Mesajın konusu" />
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="MessageDetail" class="form-label fw-semibold">Mesaj</label>
                                <textarea asp-for="MessageDetail"
                                          class="form-control"
                                          rows="7"
                                          placeholder="Mesaj içeriğini yazın"></textarea>
                                <span asp-validation-for="MessageDetail" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 p-md-4 border-top bg-light d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">
                        <a asp-area="Admin"
                           asp-controller="Message"
                           asp-action="MessageList"
                           class="btn-pastel-outline text-decoration-none justify-content-center">
                            Vazgeç
                        </a>
                        <button type="submit" class="btn-pastel-primary justify-content-center">
                            <i class="bi bi-check2-circle"></i>
                            Mesajı Kaydet
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </main>
</div>
