@model List<Experience>

@{
    ViewData["Title"] = "Deneyim";
    ViewData["Description"] = "İş deneyimleri. Pasif kayıtlar sitede gösterilmez.";

    var activeCount = Model.Count(experience => experience.IsActive);
}

@section Actions {
    <a class="btn btn-primary" asp-action="CreateExperience"><i class="bi bi-plus-lg"></i>Yeni deneyim</a>
}

@if (Model.Count == 0)
{
    <section class="glass ticks pa-empty">
        <glass-icon name="experience" size="140" />
        <h3>Henüz deneyim eklenmedi</h3>
        <p>Eklediğiniz deneyimler başlangıç tarihine göre sıralanır ve sitede zaman çizelgesi olarak görünür.</p>
        <a class="btn btn-primary" asp-action="CreateExperience"><i class="bi bi-plus-lg"></i>İlk deneyimi ekle</a>
    </section>
}
else
{
    <div class="pa-stats">
        <span><b>@Model.Count</b> kayıt</span>
        <span><b>@activeCount</b> aktif</span>
        <span><b>@(Model.Count - activeCount)</b> pasif</span>
    </div>

    <section class="glass ticks pa-panel">
        <div class="pa-table-wrap">
            <table class="pa-table">
                <thead>
                    <tr>
                        <th>Pozisyon</th>
                        <th>Tarih</th>
                        <th>Çalışma türü</th>
                        <th>Durum</th>
                        <th class="cell-actions"><span class="visually-hidden">İşlemler</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var experience in Model)
                    {
                        <tr>
                            <td>
                                <span class="cell-title">@experience.Title</span>
                                <span class="cell-sub">@experience.CompanyName@(string.IsNullOrWhiteSpace(experience.SideTitle) ? "" : $" · {experience.SideTitle}")</span>
                            </td>
                            <td class="cell-mono">
                                @experience.StartDate.ToString("yyyy-MM") → @(experience.EndDate?.ToString("yyyy-MM") ?? "devam")
                            </td>
                            <td>@(experience.WorkType ?? "—")</td>
                            <td>
                                @if (experience.IsActive)
                                {
                                    <span class="pa-badge is-on">Aktif</span>
                                }
                                else
                                {
                                    <span class="pa-badge is-off">Pasif</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <a class="btn btn-ghost btn-icon" title="Düzenle" aria-label="Düzenle"
                                   asp-action="UpdateExperience" asp-route-id="@experience.ExperienceId">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form class="d-inline" method="post"
                                      asp-action="DeleteExperience" asp-route-id="@experience.ExperienceId"
                                      onsubmit="return confirm('Bu deneyim kalıcı olarak silinecek. Emin misiniz?');">
                                    <button type="submit" class="btn btn-danger-ghost btn-icon" title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
