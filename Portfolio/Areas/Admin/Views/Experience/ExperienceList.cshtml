@model List<Portfolio.Entities.Experience>

@{
    ViewData["Title"] = "Deneyimler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var totalCount = Model.Count;
    var activeCount = Model.Count(experience => experience.IsActive);
    var passiveCount = totalCount - activeCount;
    var companyCount = Model
        .Where(experience => !string.IsNullOrWhiteSpace(experience.CompanyName))
        .Select(experience => experience.CompanyName)
        .Distinct()
        .Count();
}

<div id="main-content-wrapper">
    <header class="admin-navbar">
        <div class="d-flex align-items-center justify-content-between w-100 gap-3">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm d-lg-none p-1 border-0 text-dark"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileSidebar"
                        aria-controls="mobileSidebar"
                        aria-label="Menüyü aç">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <nav aria-label="Sayfa yolu" class="d-none d-sm-block">
                    <ol class="breadcrumb mb-0 align-items-center small">
                        <li class="breadcrumb-item"><span class="text-secondary">Yönetim Paneli</span></li>
                        <li class="breadcrumb-item active fw-semibold" aria-current="page">Deneyimler</li>
                    </ol>
                </nav>
            </div>

            <a asp-area="Admin"
               asp-controller="Experience"
               asp-action="CreateExperience"
               class="btn-pastel-primary text-decoration-none flex-shrink-0">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-sm-inline">Yeni Deneyim</span>
                <span class="d-sm-none">Ekle</span>
            </a>
        </div>
    </header>

    <main class="main-body-container flex-grow-1 p-4 p-md-4 p-lg-5">
        <section class="mb-4">
            <span class="text-uppercase fw-bold"
                  style="font-size: 0.72rem; letter-spacing: 0.08em; color: var(--primary-accent);">
                İçerik Yönetimi
            </span>
            <h1 class="h3 fw-bold mb-2 mt-1">Deneyimlerim</h1>
            <p class="text-secondary mb-0">
                Profesyonel deneyim kayıtlarını ve yayın durumlarını buradan takip edebilirsin.
            </p>
        </section>

        <section class="row g-3 mb-4" aria-label="Deneyim özeti">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div>
                        <div class="text-secondary fw-medium small">Toplam Deneyim</div>
                        <div class="h3 fw-bold my-1">@totalCount</div>
                        <small class="text-muted">Kayıtlı deneyim</small>
                    </div>
                    <div class="stat-icon-wrap"
                         style="background-color: var(--pastel-purple); color: var(--pastel-purple-text);">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div>
                        <div class="text-secondary fw-medium small">Aktif</div>
                        <div class="h3 fw-bold my-1 text-success">@activeCount</div>
                        <small class="text-muted">Yayında olan kayıt</small>
                    </div>
                    <div class="stat-icon-wrap"
                         style="background-color: var(--mint-green); color: var(--mint-green-text);">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div>
                        <div class="text-secondary fw-medium small">Pasif</div>
                        <div class="h3 fw-bold my-1">@passiveCount</div>
                        <small class="text-muted">Yayında olmayan kayıt</small>
                    </div>
                    <div class="stat-icon-wrap"
                         style="background-color: var(--soft-gray); color: var(--soft-gray-text);">
                        <i class="bi bi-eye-slash-fill"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div>
                        <div class="text-secondary fw-medium small">Şirket</div>
                        <div class="h3 fw-bold my-1">@companyCount</div>
                        <small class="text-muted">Farklı kurum</small>
                    </div>
                    <div class="stat-icon-wrap"
                         style="background-color: var(--peach); color: var(--peach-text);">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                </div>
            </div>
        </section>

        <section class="content-card overflow-hidden" aria-labelledby="experience-list-title">
            <div class="p-3 p-md-4 border-bottom d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
                <div>
                    <h2 id="experience-list-title" class="h5 fw-bold mb-1">Deneyim Listesi</h2>
                    <p class="text-secondary small mb-0">Portfolyoda kullanılan profesyonel deneyim kayıtları.</p>
                </div>
                <span class="badge badge-pastel badge-pastel-purple px-3 py-2 align-self-start align-self-sm-center">
                    @totalCount kayıt
                </span>
            </div>

            @if (totalCount == 0)
            {
                <div class="p-5 text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 64px; height: 64px; background-color: var(--pastel-purple); color: var(--primary-accent);">
                        <i class="bi bi-briefcase fs-3"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Henüz deneyim eklenmemiş</h3>
                    <p class="text-secondary mb-4">İlk profesyonel deneyimini ekleyerek listeyi oluşturmaya başlayabilirsin.</p>
                    <a asp-area="Admin"
                       asp-controller="Experience"
                       asp-action="CreateExperience"
                       class="btn-pastel-primary text-decoration-none">
                        <i class="bi bi-plus-lg"></i>
                        Yeni deneyim ekle
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle" aria-labelledby="experience-list-title">
                        <thead>
                            <tr>
                                <th scope="col" style="min-width: 90px;">ID</th>
                                <th scope="col" style="min-width: 240px;">Pozisyon / Şirket</th>
                                <th scope="col" style="min-width: 180px;">Alt Başlık</th>
                                <th scope="col" style="min-width: 280px;">Açıklama</th>
                                <th scope="col" style="min-width: 150px;">Çalışma Türü</th>
                                <th scope="col" style="min-width: 110px;">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var experience in Model)
                            {
                                var companyInitial = string.IsNullOrWhiteSpace(experience.CompanyName)
                                    ? "?"
                                    : experience.CompanyName.Trim()[0].ToString().ToUpperInvariant();

                                <tr>
                                    <td>
                                        <span class="badge badge-pastel badge-pastel-purple">#@experience.ExperienceId</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="company-avatar" aria-hidden="true">@companyInitial</div>
                                            <div>
                                                <div class="fw-semibold text-dark">@(experience.Title ?? "Başlık belirtilmedi")</div>
                                                <div class="small text-secondary">@(experience.CompanyName ?? "Şirket belirtilmedi")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="text-secondary">@(experience.SideTitle ?? "—")</span></td>
                                    <td>
                                        <div class="text-secondary text-truncate" style="max-width: 360px;" title="@experience.Description">
                                            @(experience.Description ?? "Açıklama eklenmemiş")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-pastel badge-pastel-type">
                                            <i class="bi bi-clock"></i>
                                            @(experience.WorkType ?? "Belirtilmedi")
                                        </span>
                                    </td>
                                    <td>
                                        @if (experience.IsActive)
                                        {
                                            <span class="badge badge-pastel badge-pastel-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.4rem;"></i>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pastel badge-pastel-completed">
                                                <i class="bi bi-circle" style="font-size: 0.45rem;"></i>
                                                Pasif
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="px-3 px-md-4 py-3 border-top text-secondary small">
                    Toplam <strong class="text-dark">@totalCount</strong> deneyim gösteriliyor.
                </div>
            }
        </section>
    </main>
</div>

