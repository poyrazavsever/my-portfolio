@model Experience

@{
    ViewData["Title"] = "Deneyimi düzenle";
    ViewData["Description"] = $"{Model.Title} · {Model.CompanyName}";
}

<form asp-action="UpdateExperience" method="post" class="glass ticks pa-panel-pad">
    <input type="hidden" asp-for="ExperienceId" />
    <partial name="_ExperienceForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="ExperienceList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Değişiklikleri kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
