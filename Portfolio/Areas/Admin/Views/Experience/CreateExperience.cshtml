@model Experience

@{
    ViewData["Title"] = "Yeni deneyim";
    ViewData["Description"] = "Portfolyonun deneyim bölümüne yeni bir kayıt ekleyin.";
}

<form asp-action="CreateExperience" method="post" class="glass ticks pa-panel-pad">
    <partial name="_ExperienceForm" model="Model" />

    <div class="pa-form-actions">
        <a class="btn btn-ghost" asp-action="ExperienceList">Vazgeç</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
