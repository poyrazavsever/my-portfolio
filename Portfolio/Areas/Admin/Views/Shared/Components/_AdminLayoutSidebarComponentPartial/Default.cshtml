@model Portfolio.Areas.Admin.Models.AdminSidebarViewModel

@if (!Model.IsMobile)
{
    <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <partial name="_BrandLogo" />Poyraz Avsever
    </a>
}

<ul class="admin-nav">
    @foreach (var item in Model.Items)
    {
        if (item.IsSeparator)
        {
            <li class="admin-nav-sep" role="separator"></li>
            continue;
        }

        var isActive = item.Controller is not null
                       && string.Equals(item.Controller, Model.ActiveController, StringComparison.OrdinalIgnoreCase);

        <li>
            @if (item.ExternalUrl is not null)
            {
                <a class="admin-nav-link" href="@item.ExternalUrl" target="_blank" rel="noopener">
                    <i class="bi @item.Icon"></i>@item.Title<i class="bi bi-arrow-up-right nav-ext"></i>
                </a>
            }
            else if (!item.IsReady)
            {
                <span class="admin-nav-link is-disabled" title="Yakında" aria-disabled="true">
                    <i class="bi @item.Icon"></i>@item.Title
                </span>
            }
            else
            {
                <a class="admin-nav-link @(isActive ? "is-active" : null)"
                   aria-current="@(isActive ? "page" : null)"
                   asp-area="Admin" asp-controller="@item.Controller" asp-action="@item.Action">
                    <i class="bi @item.Icon"></i>@item.Title
                    @if (item.Badge > 0)
                    {
                        <span class="pa-count" title="@item.Badge okunmamış">@item.Badge</span>
                    }
                </a>
            }
        </li>
    }
</ul>

<div class="admin-user">
    <img class="admin-avatar" src="/assets/brand/avatar-96.webp" width="34" height="34" alt="" />
    <div>
        <b>Poyraz Avsever</b>
        <small>@(User.Identity?.Name ?? "Yönetici")</small>
    </div>
    @* Çıkış POST ile: GET bir link olsaydı başka bir site <img src="/Admin/Account/Logout"> ile oturumu kapatabilirdi. *@
    <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout" class="admin-logout">
        <button type="submit" class="btn btn-ghost btn-icon" title="Çıkış yap" aria-label="Çıkış yap">
            <i class="bi bi-box-arrow-right"></i>
        </button>
    </form>
</div>
