<header class="admin-topbar glass">
    <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <span class="brand-mark"></span>Poyraz Avsever
    </a>
    <button class="btn btn-ghost btn-icon" type="button"
            data-bs-toggle="offcanvas" data-bs-target="#adminOffcanvas"
            aria-controls="adminOffcanvas" aria-label="Menüyü aç">
        <i class="bi bi-list"></i>
    </button>
</header>

<div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="adminOffcanvas" aria-label="Yönetim menüsü">
    <div class="offcanvas-body">
        @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial", new { mobile = true })
    </div>
</div>
