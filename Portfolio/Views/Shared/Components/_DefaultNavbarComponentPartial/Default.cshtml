@model SiteChromeViewModel

<header class="site-nav" data-site-nav>
    <nav class="site-nav-bar glass" aria-label="Ana menü">
        <a class="site-brand" asp-controller="Default" asp-action="Index" fragment="top">
            <partial name="_BrandLogo" />@Model.Name
        </a>

        <button class="btn btn-ghost btn-icon site-nav-toggle" type="button"
                data-bs-toggle="collapse" data-bs-target="#siteNavLinks"
                aria-controls="siteNavLinks" aria-expanded="false" aria-label="Menüyü aç">
            <i class="bi bi-list"></i>
        </button>

        <div class="collapse site-nav-collapse" id="siteNavLinks">
            <ul class="site-nav-links">
                <li><a href="/#about" data-nav-link>Hakkımda</a></li>
                <li><a href="/#experience" data-nav-link>Deneyim</a></li>
                <li><a href="/#skills" data-nav-link>Yetenekler</a></li>
                <li><a href="/#projects" data-nav-link>Projeler</a></li>
                <li><a href="/#contact" data-nav-link>İletişim</a></li>
            </ul>

            @if (Model.HasCv)
            {
                <a class="btn btn-primary site-nav-cta" asp-controller="Default" asp-action="DownloadCv">
                    <i class="bi bi-download"></i>CV indir
                </a>
            }
            else
            {
                <a class="btn btn-primary site-nav-cta" href="/#contact">İletişime geç</a>
            }
        </div>
    </nav>
</header>
