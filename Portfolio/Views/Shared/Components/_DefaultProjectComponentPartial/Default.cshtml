@model List<Portfolio.Entities.Category>

<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SEÇİLMİŞ ÇALIŞMALAR</span>
            <h2 class="section-title">Projelerim</h2>
            <p class="section-subtitle">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
        </div>

        @if (Model.Count > 1)
        {
            <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
                <button type="button" class="filter-btn active" data-filter="all">Tümü</button>
                @foreach (var category in Model)
                {
                    <button type="button" class="filter-btn" data-filter="category-@category.CategoryId">
                        @category.CategoryName
                    </button>
                }
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-center text-secondary mb-0">Projeler yakında burada yer alacak.</p>
        }
        else
        {
            <div class="row g-4" id="projectGrid">
                @foreach (var category in Model)
                {
                    @foreach (var project in category.Projects)
                    {
                        <div class="col-lg-4 col-md-6 project-item" data-category="category-@category.CategoryId">
                            <article class="project-card reveal-on-scroll">
                                <div class="project-thumb">
                                    @if (!string.IsNullOrWhiteSpace(project.CoverImageUrl))
                                    {
                                        <img class="project-cover-image"
                                             src="@project.CoverImageUrl"
                                             alt="@project.Title proje kapak görseli"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="project-image-placeholder" aria-hidden="true">
                                            <i class="bi bi-code-slash"></i>
                                        </div>
                                    }
                                </div>

                                <div class="project-body">
                                    <span class="project-category-badge">@category.CategoryName</span>
                                    <h3 class="project-title">@project.Title</h3>
                                    <p class="project-desc">@project.Description</p>

                                    @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                                    {
                                        <div class="project-footer">
                                            <a href="@project.GithubUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="project-link-btn">
                                                <i class="bi bi-github"></i> GitHub
                                            </a>
                                        </div>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>
