@model ProjectSectionViewModel

<section class="site-section" id="projects">
    <div class="site-container">
        <partial name="_SectionHead" model='new SectionHeadModel("projects", "Projeler", "Kategoriye göre filtreleyin veya proje adı ve teknolojiye göre arayın.")' />

        <div class="project-toolbar" data-project-toolbar>
            <div class="project-filters" role="group" aria-label="Kategori filtresi">
                <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
                    Tümü <span>@Model.Projects.Count</span>
                </button>
                @foreach (var category in Model.Categories)
                {
                    var count = Model.Projects.Count(project => project.CategoryId == category.CategoryId);
                    <button type="button" class="chip" data-filter="@category.CategoryId" aria-pressed="false">
                        @category.CategoryName <span>@count</span>
                    </button>
                }
            </div>

            <label class="project-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="visually-hidden">Projelerde ara</span>
                <input type="search" class="form-control" placeholder="Projelerde ara" autocomplete="off" data-project-search />
            </label>
        </div>

        <div class="project-grid" data-project-grid>
            @foreach (var project in Model.Projects)
            {
                var searchText = $"{project.Title} {project.Description} {project.Category?.CategoryName}";
                <article class="project-card glass" data-category="@project.CategoryId" data-search="@searchText">
                    <div class="project-cover">
                        @if (!string.IsNullOrWhiteSpace(project.CoverImageUrl))
                        {
                            <img src="@project.CoverImageUrl" alt="@project.Title kapak görseli" loading="lazy" />
                        }
                        else
                        {
                            <glass-icon name="projects" size="96" static="true" />
                        }
                    </div>
                    <div class="project-body">
                        <span class="project-category">@project.Category?.CategoryName</span>
                        <h3>@project.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(project.Description))
                        {
                            <p>@project.Description</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                        {
                            <a class="project-link" href="@project.GithubUrl" target="_blank" rel="noopener">
                                <i class="bi bi-github"></i>Kaynak kod<i class="bi bi-arrow-up-right"></i>
                            </a>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="project-empty glass" data-project-empty hidden>
            <p>Bu ölçütlere uyan proje bulunamadı.</p>
            <button type="button" class="btn btn-ghost" data-project-reset>Filtreleri temizle</button>
        </div>
    </div>
</section>
