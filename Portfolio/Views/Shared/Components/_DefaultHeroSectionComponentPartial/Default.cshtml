@model HeroViewModel

<section class="hero" aria-labelledby="hero-title">
    <svg class="hero-drawing" viewBox="0 0 400 400" fill="none" aria-hidden="true">
        <circle cx="200" cy="200" r="168" stroke="var(--pa-red)" opacity=".28" />
        <circle cx="200" cy="200" r="112" stroke="var(--pa-red)" opacity=".18" />
        <circle cx="200" cy="200" r="46" stroke="var(--pa-red)" opacity=".45" />
        <path d="M8 200H392M200 8V392" stroke="#fff" opacity=".1" />
        <path d="M81 81 319 319" stroke="#fff" opacity=".06" />
        <rect x="150" y="150" width="100" height="100" stroke="var(--pa-red)" opacity=".24" />
    </svg>

    <div class="site-container hero-grid">
        <div class="hero-copy">
            <h1 id="hero-title">@Model.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Role))
            {
                <p class="hero-role">@Model.Role</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Intro))
            {
                <p class="hero-intro">@Model.Intro</p>
            }

            <div class="hero-meta">
                @if (Model.OpenToWork)
                {
                    <span class="hero-status"><i></i>Yeni projelere açık</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Location))
                {
                    <span>@Model.Location</span>
                }
                <span>UTC+03:00</span>
            </div>

            <div class="hero-actions">
                @if (Model.HasCv)
                {
                    <a class="btn btn-primary" asp-controller="Default" asp-action="DownloadCv"><i class="bi bi-download"></i>CV indir</a>
                }
                <a class="btn @(Model.HasCv ? "btn-ghost" : "btn-primary")" href="#contact">İletişime geç</a>
                <a class="btn btn-ghost" href="#projects">Projeler</a>

                <span class="hero-social">
                    @if (!string.IsNullOrWhiteSpace(Model.Github))
                    {
                        <a class="btn btn-ghost btn-icon" href="@Model.Github" target="_blank" rel="noopener" aria-label="GitHub"><i class="bi bi-github"></i></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Linkedin))
                    {
                        <a class="btn btn-ghost btn-icon" href="@Model.Linkedin" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a class="btn btn-ghost btn-icon" href="mailto:@Model.Email" aria-label="E-posta"><i class="bi bi-envelope"></i></a>
                    }
                </span>
            </div>
        </div>

        <figure class="hero-portrait glass ticks">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" width="440" height="520" fetchpriority="high" />
            }
            else
            {
                <glass-icon name="about" size="200" />
            }
        </figure>
    </div>
</section>
