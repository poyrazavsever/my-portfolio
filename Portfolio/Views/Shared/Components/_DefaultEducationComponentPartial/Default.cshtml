@model List<Education>

<section class="site-section" id="education">
    <div class="site-container">
        <partial name="_SectionHead" model='new SectionHeadModel("education", "Eğitim")' />

        <ol class="timeline">
            @foreach (var education in Model)
            {
                <li class="timeline-item @(education.EndDate is null ? "is-current" : null)">
                    <div class="timeline-date">
                        <time datetime="@education.StartDate.ToString("yyyy-MM")">@education.StartDate.ToString("yyyy")</time>
                        <span>—</span>
                        @if (education.EndDate is DateOnly end)
                        {
                            <time datetime="@end.ToString("yyyy-MM")">@end.ToString("yyyy")</time>
                        }
                        else
                        {
                            <span class="timeline-now">Devam ediyor</span>
                        }
                    </div>

                    <article class="timeline-card glass">
                        <h3>@education.EducationTitle</h3>
                        @if (!string.IsNullOrWhiteSpace(education.SubTitle))
                        {
                            <p class="timeline-org">@education.SubTitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(education.Description))
                        {
                            <p class="timeline-desc">@education.Description</p>
                        }
                    </article>
                </li>
            }
        </ol>
    </div>
</section>
