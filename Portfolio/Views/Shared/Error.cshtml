@model ErrorViewModel
@{
    ViewData["Title"] = "Bir hata oluştu";
}

<section class="site-section">
    <div class="site-container">
        <div class="glass ticks pa-empty">
            <glass-icon name="dashboard" size="120" static="true" />
            <h3>Bir şeyler ters gitti</h3>
            <p>İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen ana sayfaya dönüp tekrar deneyin.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-mono text-faint" style="font-size:12px">İstek kimliği: @Model.RequestId</p>
            }
            <a class="btn btn-primary" asp-controller="Default" asp-action="Index">Ana sayfaya dön</a>
        </div>
    </div>
</section>
